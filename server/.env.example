# 运行环境
NODE_ENV=production
PORT=8080

# JWT —— 生产环境必须改成强随机串（至少 32 字符），否则生产模式拒绝启动
JWT_SECRET=please-change-me-to-a-strong-random-32-char-secret
JWT_EXPIRES=8h

# 数据库文件路径（留空则默认 server/data/zhuomeng.db）
DB_PATH=

# 前端静态目录（留空则默认 项目根/public）
PUBLIC_DIR=

# CORS 白名单（逗号分隔），必须包含你前端访问的域名/IP，否则浏览器会拦截登录请求
CORS_ORIGINS=http://office.zhuomeng-tech.com,https://office.zhuomeng-tech.com,http://localhost:8080

# 限速（每 IP 每窗口最大请求数）
# 服务器在 nginx 反代后建议放宽；如需更严，调小这两个值
RATE_LIMIT_GLOBAL=600
RATE_LIMIT_LOGIN=10
