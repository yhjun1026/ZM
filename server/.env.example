# 运行环境
NODE_ENV=development
PORT=8080

# JWT —— 生产环境必须改成强随机串（至少 32 字符），否则生产模式拒绝启动
JWT_SECRET=dev-only-change-me-to-a-strong-random-secret-32chars
JWT_EXPIRES=8h

# 数据库文件路径（留空则默认 server/data/zhuomeng.db）
DB_PATH=

# 前端静态目录（留空则默认 项目根/public）
PUBLIC_DIR=

# CORS 白名单（逗号分隔）
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 限速（每 IP 每窗口最大请求数）
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_LOGIN=5
